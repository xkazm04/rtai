class_name CityBake
extends RefCounted
## AST-12: chunks are build output, baked from the authored district by the deterministic
## generator. bake() encodes every chunk; golden_text() is the committed hash list
## (data/generated/city_chunks.sha256); check() bakes twice, byte-compares and compares the
## result with the committed list.

const GOLDEN: String = "res://data/generated/city_chunks.sha256"
const OUT_DIR: String = "res://data/generated/city"

var gen: CityGen
var chunks: int = SimConst.CITY_CHUNKS


func _init(p_gen: CityGen, p_chunks: int) -> void:
	gen = p_gen
	chunks = p_chunks


## file name -> GTCH bytes, for every chunk of the district, in row-major order.
func bake() -> Dictionary[String, PackedByteArray]:
	var out: Dictionary[String, PackedByteArray] = {}
	for cy: int in chunks:
		for cx: int in chunks:
			var bytes: PackedByteArray = ChunkCodec.encode(
				gen.gen_chunk(cx, cy), CityGen.GENERATOR_VERSION
			)
			out[ChunkCodec.file_name(cx, cy)] = bytes
	return out


func golden_text(baked: Dictionary[String, PackedByteArray]) -> String:
	var lines: Array[String] = [
		(
			"# DO NOT EDIT. Generated by res://dev/bake_city.gd (%s, generator v%d, GTCH v%d)."
			% [gen.district_id, CityGen.GENERATOR_VERSION, ChunkCodec.FORMAT_VERSION]
		),
	]
	for file: String in baked:
		lines.append("%s  %s" % [_sha256(baked[file]), file])
	return "\n".join(lines) + "\n"


## "" when two bakes are byte-identical and match the committed list, else the first problem.
func check() -> String:
	var a: Dictionary[String, PackedByteArray] = bake()
	var b: Dictionary[String, PackedByteArray] = bake()
	for file: String in a:
		if a[file] != b[file]:
			return "%s differs between two bakes (the generator is not deterministic)" % file
	var committed: String = FileAccess.get_file_as_string(GOLDEN)
	if committed == "":
		return "no golden hash list at %s: run res://dev/bake_city.gd" % GOLDEN
	var want: String = golden_text(a)
	if committed != want:
		return "chunks differ from %s: %s" % [GOLDEN, _first_diff(committed, want)]
	return ""


## Writes every chunk file and the golden list; returns the number of chunks written.
func write_files() -> int:
	var baked: Dictionary[String, PackedByteArray] = bake()
	var dir: String = ProjectSettings.globalize_path(OUT_DIR)
	if DirAccess.make_dir_recursive_absolute(dir) != OK:
		return -1
	for file: String in baked:
		var f: FileAccess = FileAccess.open(dir.path_join(file), FileAccess.WRITE)
		if f == null or not f.store_buffer(baked[file]):
			return -1
		f.close()
	var g: FileAccess = FileAccess.open(ProjectSettings.globalize_path(GOLDEN), FileAccess.WRITE)
	if g == null or not g.store_string(golden_text(baked)):
		return -1
	g.close()
	return baked.size()


static func _sha256(bytes: PackedByteArray) -> String:
	var h: HashingContext = HashingContext.new()
	var err: int = h.start(HashingContext.HASH_SHA256)
	err |= h.update(bytes)
	return h.finish().hex_encode() if err == OK else ""


static func _first_diff(a: String, b: String) -> String:
	var la: PackedStringArray = a.split("\n")
	var lb: PackedStringArray = b.split("\n")
	for i: int in mini(la.size(), lb.size()):
		if la[i] != lb[i]:
			return "line %d: committed '%s', baked '%s'" % [i + 1, la[i], lb[i]]
	return "line count %d vs %d" % [la.size(), lb.size()]
