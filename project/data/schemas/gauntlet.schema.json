            "arcade",
            "depot",
            "glass",
            "masonry",
            "office",
            "retail"
          ]
        },
        "high": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string"
        },
        "high_scale": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "landmark": {
          "enum": [
            "barriers",
            "bus",
            "dock",
            "market",
            "neck",
            "signals",
            "square",
            "viaduct"
          ]
        },
        "lots": {
          "maximum": 4,
          "minimum": 1,
          "type": "integer"
        },
        "low": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string"
        },
        "low_scale": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "sidewalk_m": {
          "exclusiveMinimum": 0,
          "type": "number"
