  "$id": "gtai.gauntlet/1",
  "additionalProperties": false,
  "properties": {
    "boss_every": {
      "minimum": 1,
      "type": "integer"
    },
    "budget": {
      "additionalProperties": false,
      "properties": {
        "base": {
          "minimum": 0,
          "type": "integer"
        },
        "per_wave": {
          "minimum": 0,
          "type": "integer"
        },
        "unit": {
          "description": "Number of budget units in one tier of default enemy cost.",
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "base",
        "per_wave",
        "unit"
      ],
      "type": "object"
    },
    "cost": {
      "additionalProperties": {
        "minimum": 1,
        "type": "integer"
      },
      "description": "Cost in budget units by enemy id. Omitted enemies cost their tier multiplied by budget.unit.",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "type": "object"
    },
    "enemy_damage_k": {
      "default": 1,
      "description": "Multiplies the damage gauntlet foes deal to Rivet. Rivet's own blast and quest 1 are unaffected.",
      "exclusiveMinimum": 0,
      "type": "number"
    },
    "max_alive": {
      "minimum": 1,
      "type": "integer"
    },
    "on_timeout": {
      "enum": [
        "next_wave"
      ]
    },
    "rivet": {
      "additionalProperties": false,
      "properties": {
        "repair_delay_s": {
          "minimum": 0,
          "type": "number"
        },
        "repair_in_wave": {
          "default": false,
          "type": "boolean"
        },
        "repair_per_s": {
          "minimum": 0,
          "type": "number"
        }
      },
      "type": "object"
    },
    "roster_exclude": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "schema": {
      "const": "gtai.gauntlet/1"
    },
    "segments": {
      "items": {
        "$ref": "#/$defs/segment"
      },
      "minItems": 1,
      "type": "array"
    },
    "target_wave_s": {
      "exclusiveMinimum": 0,
      "type": "number"
    },
    "tier_map": {
      "additionalProperties": {
        "maximum": 5,
        "minimum": 1,
        "type": "integer"
      },
      "description": "Provisional fallback until every enemies.json archetype supplies its own tier.",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$",
        "type": "string"
      },
      "type": "object"
    },
    "tier_unlock_wave": {
      "description": "First allowed wave by tier. The tier-five war machine occupies the boss slot from wave five. Regular tiers three and four unlock later.",
      "items": {
        "minimum": 1,
        "type": "integer"
      },
      "maxItems": 5,
      "minItems": 5,
      "type": "array"
    },
    "wave_timeout_s": {
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "schema",
    "segments",
    "boss_every",
    "target_wave_s",
    "budget",
    "tier_unlock_wave",
    "tier_map",
    "max_alive",
    "on_timeout",
    "wave_timeout_s"
  ],
  "type": "object"
}
