{
  "$defs": {
    "fx": {
      "additionalProperties": false,
      "properties": {
        "anchor_px": {
          "$ref": "#/$defs/vec2"
        },
        "art": {
          "pattern": "^res://features/combat/weapons/art/(fx|gore)/[a-z0-9_]+\\.png$",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string"
        },
        "size_px": {
          "$ref": "#/$defs/vec2"
        }
      },
      "required": [
        "id",
        "art",
        "size_px",
        "anchor_px"
      ],
      "type": "object"
    },
    "path": {
      "pattern": "^res://features/combat/weapons/art/[a-z0-9_]+/[a-z0-9_]+\\.png$",
      "type": "string"
    },
    "vec2": {
      "items": {
        "minimum": 0,
        "type": "integer"
      },
      "minItems": 2,
      "type": "array"
    },
    "weapon": {
      "additionalProperties": false,
      "properties": {
        "casing": {
          "pattern": "^[a-z0-9_]*$",
          "type": "string"
        },
        "grip_class": {
          "enum": [
            "one_hand",
            "two_hand_long",
            "shoulder",
            "backpack_hose",
            "thrown",
            "heavy_two_hand",
            "hip_belt",
            "melee_one_hand",
            "melee_two_hand"
          ],
          "type": "string"
        },
        "grip_px": {
          "$ref": "#/$defs/vec2"
        },
        "held": {
          "$ref": "#/$defs/path"
        },
        "icon": {
          "$ref": "#/$defs/path"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string"
        },
        "length_m": {
          "maximum": 3,
          "minimum": 0.1,
          "type": "number"
        },
        "length_px": {
          "minimum": 1,
          "type": "integer"
        },
        "muzzle_fx": {
          "pattern": "^[a-z0-9_]*$",
          "type": "string"
        },
        "muzzle_px": {
          "$ref": "#/$defs/vec2"
        },
        "part_grip_px": {
          "additionalProperties": {
            "$ref": "#/$defs/vec2"
          },
          "type": "object"
        },
        "parts": {
          "additionalProperties": {
            "$ref": "#/$defs/path"
          },
          "type": "object"
        },
        "pickup": {
          "$ref": "#/$defs/path"
        },
        "projectile_fx": {
          "pattern": "^[a-z0-9_]*$",
          "type": "string"
        },
        "projectile_k": {
          "maximum": 3,
          "minimum": 0.5,
          "type": "number"
        },
        "size_px": {
          "$ref": "#/$defs/vec2"
        }
      },
      "required": [
        "id",
        "grip_class",
        "held",
        "pickup",
        "icon",
        "size_px",
        "grip_px",
        "muzzle_px",
        "length_px",
        "length_m",
        "muzzle_fx",
        "projectile_fx",
        "casing",
        "parts"
      ],
      "type": "object"
    }
  },
  "$id": "gtai.weapon-art/1",
  "additionalProperties": false,
  "properties": {
    "doc": {
      "type": "string"
    },
    "fx": {
      "items": {
        "$ref": "#/$defs/fx"
      },
      "minItems": 1,
      "type": "array"
    },
    "fx_colour_dir": {
      "type": "string"
    },
    "fx_draw_scale": {
      "maximum": 8,
      "minimum": 0.1,
      "type": "number"
    },
    "held_small_below_ppm": {
      "minimum": 0,
      "type": "number"
    },
    "pickup_min_span_m": {
      "maximum": 3,
      "minimum": 0,
      "type": "number"
    },
    "rig_px_per_m": {
      "minimum": 1,
      "type": "integer"
    },
    "schema": {
      "const": "gtai.weapon-art/1",
      "type": "string"
    },
    "weapons": {
      "items": {
        "$ref": "#/$defs/weapon"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "schema",
    "doc",
    "rig_px_per_m",
    "weapons",
    "fx",
    "fx_draw_scale"
  ],
  "type": "object"
}
