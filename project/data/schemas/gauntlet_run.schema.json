{
  "$defs": {
    "wave": {
      "additionalProperties": false,
      "properties": {
        "bond": {
          "additionalProperties": {
            "minimum": 0,
            "type": "number"
          },
          "description": "Cumulative deploy bond per form at the end of this wave. Omitted when bonds are disabled.",
          "minProperties": 1,
          "propertyNames": {
            "enum": [
              "dent",
              "kerf",
              "ohm",
              "tonnage"
            ]
          },
          "type": "object"
        },
        "cover_ticks": {
          "description": "Simulation ticks during this wave when the bot chose cover.",
          "minimum": 0,
          "type": "integer"
        },
        "damage_taken": {
          "minimum": 0,
          "type": "number"
        },
        "dashes": {
          "description": "Directional dashes Rivet started during this wave, including its final tick.",
          "minimum": 0,
          "type": "integer"
        },
        "deploy_kills": {
          "additionalProperties": {
            "minimum": 0,
            "type": "integer"
          },
          "description": "Direct kills credited to deployments released during this wave, keyed by each deployed form. Zero represents a measured deployment without a kill.",
          "minProperties": 1,
          "propertyNames": {
            "enum": [
              "dent",
              "kerf",
              "ohm",
              "tonnage"
            ]
          },
          "type": "object"
        },
        "deploy_stun_s": {
          "additionalProperties": {
            "minimum": 0,
            "type": "number"
          },
          "description": "Living machine-seconds spent under a deployed short circuit during this wave, keyed by form. Counts each affected machine once per held tick. Omitted for unmeasured forms.",
          "minProperties": 1,
          "propertyNames": {
            "enum": [
              "dent",
              "kerf",
              "ohm",
              "tonnage"
            ]
          },
          "type": "object"
        },
        "deploys": {
          "additionalProperties": {
            "minimum": 1,
            "type": "integer"
          },
          "description": "Ghost deployments released during this wave, keyed by form. Omitted when none were released.",
          "minProperties": 1,
          "propertyNames": {
            "enum": [
              "dent",
              "kerf",
              "ohm",
              "tonnage"
            ]
          },
          "type": "object"
        },
        "enemies": {
          "additionalProperties": {
            "minimum": 1,
            "type": "integer"
          },
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "type": "object"
        },
        "form_seconds": {
          "additionalProperties": {
            "minimum": 0,
            "type": "number"
          },
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "type": "object"
        },
        "guard_deflects": {
          "description": "Hostile rounds deflected by Rivet's guard during this wave. Recorded under wheel controls, including zero. Omitted under legacy controls.",
          "minimum": 0,
          "type": "integer"
        },
        "guard_ticks": {
          "description": "Simulation ticks during this wave when the bot issued the guard input.",
          "minimum": 0,
          "type": "integer"
        },
        "hits": {
          "description": "All wounding or lethal damage events against wave members, including melee, area effects and damage from other sources.",
          "minimum": 0,
          "type": "integer"
        },
        "hits_gun": {
          "description": "Direct contacts on wave members by rounds fired by Rivet. Each pellet can score once. Splash, chains, burns and reflected hostile rounds are excluded.",
          "minimum": 0,
          "type": "integer"
        },
        "hits_melee": {
          "description": "Contacts on wave members from Rivet using his hands, a held melee weapon or a direct physical form attack. Each body struck counts once.",
          "minimum": 0,
          "type": "integer"
        },
        "hp": {
          "additionalProperties": false,
          "description": "Rivet HP at wave start, lowest HP, final sampled HP, highest HP capacity, and sum of positive HP steps within the wave.",
          "properties": {
            "end": {
              "minimum": 0,
              "type": "number"
            },
            "max": {
              "minimum": 0,
              "type": "number"
            },
            "min": {
              "minimum": 0,
              "type": "number"
            },
            "repaired": {
              "minimum": 0,
              "type": "number"
            },
            "start": {
              "minimum": 0,
              "type": "number"
            }
          },
          "required": [
            "end",
            "max",
            "min",
            "repaired",
            "start"
          ],
          "type": "object"
        },
        "machine": {
          "additionalProperties": false,
          "description": "Bot measurements for the first war machine in this wave. Omitted when no war machine is tracked.",
          "properties": {
            "claw_reach_ticks": {
              "description": "Observed ticks when the machine was within Rivet's claw reach.",
              "minimum": 0,
              "type": "integer"
            },
            "cover_ticks": {
              "description": "Observed ticks when the bot chose cover.",
              "minimum": 0,
              "type": "integer"
            },
            "guard_ticks": {
              "description": "Observed ticks when the bot issued the guard input.",
              "minimum": 0,
              "type": "integer"
            },
            "hp_lost": {
              "description": "Total HP lost by the tracked machine during observed ticks.",
              "minimum": 0,
              "type": "number"
            },
            "rolling_ticks": {
              "description": "Observed ticks when Rivet was rolling.",
              "minimum": 0,
              "type": "integer"
            },
            "ticks": {
              "description": "Simulation ticks when the bot observed the tracked machine.",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "claw_reach_ticks",
            "cover_ticks",
            "guard_ticks",
            "hp_lost",
            "rolling_ticks",
            "ticks"
          ],
          "type": "object"
        },
        "moves": {
          "additionalProperties": {
            "minimum": 1,
            "type": "integer"
          },
          "description": "Uses of each move that had an effect during this wave. Omitted when none did.",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "type": "object"
        },
        "n": {
          "minimum": 1,
          "type": "integer"
        },
        "rolls": {
          "minimum": 0,
          "type": "integer"
        },
        "seconds": {
          "minimum": 0,
          "type": "number"
        },
        "self_damage": {
          "description": "HP Rivet lost to his own splash during this wave, after armour and limited to his remaining HP.",
          "minimum": 0,
          "type": "number"
        },
        "shots": {
          "description": "Successful Rivet trigger pulls during the wave. A volley counts once even when it fires several pellets.",
          "minimum": 0,
          "type": "integer"
        },
        "spawn_delayed": {
          "description": "Roster members held back by the live hostile cap when this wave was scheduled.",
          "minimum": 0,
          "type": "integer"
        },
        "timed_out": {
          "const": true,
          "description": "This wave was still fighting when its timer called the next wave into the same block."
        }
      },
      "required": [
        "n"
      ],
      "type": "object"
    }
  },
  "$id": "gtai.gauntlet-run/1",
  "additionalProperties": false,
  "properties": {
    "capped": {
      "const": true,
      "description": "The simulation reached the gauntlet tick cap before the run ended."
    },
    "controls": {
      "enum": [
        "legacy",
        "wheel"
      ]
    },
    "death": {
      "additionalProperties": false,
      "properties": {
        "by": {
          "pattern": "^[a-z][a-z0-9_-]*$",
          "type": "string"
        },
        "wave": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "wave"
      ],
      "type": "object"
    },
    "mods": {
      "additionalProperties": false,
      "properties": {
        "damage": {
          "type": "number"
        },
        "guard_meter": {
          "type": "number"
        },
        "hp_max": {
          "type": "number"
        },
        "regen": {
          "type": "number"
        },
        "speed": {
          "type": "number"
        }
      },
      "required": [],
      "type": "object"
    },
    "picks": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "offered": {
            "items": {
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            "maxItems": 3,
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "taken": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "wave": {
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "wave",
          "offered",
          "taken"
        ],
        "type": "object"
      },
      "minItems": 0,
      "type": "array"
    },
    "profile": {
      "enum": [
        "human",
        "novice",
        "average",
        "expert"
      ]
    },
    "schema": {
      "const": "gtai.gauntlet-run/1"
    },
    "seed": {
      "maximum": 4294967295,
      "minimum": 0,
      "type": "integer"
    },
    "wave_reached": {
      "minimum": 0,
      "type": "integer"
    },
    "wave_timeout_s": {
      "description": "Seconds before another wave can stack. Present only when the dev launch flag overrides the street timer.",
      "minimum": 1,
      "type": "integer"
    },
    "waves": {
      "items": {
        "$ref": "#/$defs/wave"
      },
      "minItems": 0,
      "type": "array"
    }
  },
  "required": [
    "schema",
    "seed",
    "profile",
    "controls",
    "wave_reached",
    "waves",
    "picks",
    "mods"
  ],
  "type": "object"
}
