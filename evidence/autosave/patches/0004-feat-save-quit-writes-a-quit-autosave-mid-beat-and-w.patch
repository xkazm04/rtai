From 96fa79d24c0d17e197b506482fe8dec5bdaa1f30 Mon Sep 17 00:00:00 2001
From: xkazm04 <kazdan@seznam.cz>
Date: Tue, 3 Nov 2026 12:32:46 +0100
Subject: [PATCH] feat(save): quit writes a 'quit' autosave mid-beat and waits
 for it (SAV-08); bound-input scenario lands on its tick and hash

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 evidence/autosave/autosave-input.json         |  7 ++++-
 project/boot/collect_call/quest1_autosave.gd  | 12 +++++++++
 project/boot/quest1_game.gd                   | 18 +++++++++++++
 .../scenarios/scenario_autosave_input.gd      | 27 ++++++++++++++++++-
 4 files changed, 62 insertions(+), 2 deletions(-)

diff --git a/evidence/autosave/autosave-input.json b/evidence/autosave/autosave-input.json
index b89ee59..49b02f7 100644
--- a/evidence/autosave/autosave-input.json
+++ b/evidence/autosave/autosave-input.json
@@ -8,7 +8,7 @@
     "point": "as-b4-dock",
     "tick": 5669
   },
-  "load_1_ms_contended": 751,
+  "load_1_ms_contended": 740,
   "load_2": {
     "beat": "b3-toner-room",
     "tick": 2421
@@ -17,6 +17,11 @@
     "notice": "A save was damaged. Loaded the last good one.",
     "point": "as-b3-toner-room"
   },
+  "quit_save": {
+    "beat": "b3-toner-room",
+    "hash": "c121ca2f28ee418918b8ec8cca72d71d89ad4c1d09cb3b47c49bb4d48ca80b2e",
+    "tick": 2466
+  },
   "saved": {
     "as-b2-payphone": {
       "beat": "b2-payphone",
diff --git a/project/boot/collect_call/quest1_autosave.gd b/project/boot/collect_call/quest1_autosave.gd
index 4d7efbc..18be723 100644
--- a/project/boot/collect_call/quest1_autosave.gd
+++ b/project/boot/collect_call/quest1_autosave.gd
@@ -27,6 +27,18 @@ func poll() -> void:
 	_saver.poll(runner.beat_index, runner.state == QuestRunner.State.SUCCEEDED)
 
 
+## An autosave outside the quest's declared edges (the quit point, SAV-08): the snapshot of this
+## tick goes to the sink at once. False when there is no sink.
+func save_now(point: String) -> bool:
+	if not sink.is_valid():
+		return false
+	var snap: Dictionary = snapshot(point)
+	var body: Dictionary = snap.get("body", {})
+	var meta: Dictionary = snap.get("meta", {})
+	_send(point, body, meta)
+	return true
+
+
 ## What a slot carries: the checkpoint at this tick plus the meta.json fields.
 func snapshot(_point: String) -> Dictionary:
 	var beat: String = _session.beat_id()
diff --git a/project/boot/quest1_game.gd b/project/boot/quest1_game.gd
index caf0b80..46e60aa 100644
--- a/project/boot/quest1_game.gd
+++ b/project/boot/quest1_game.gd
@@ -8,6 +8,8 @@ extends Node
 
 signal started
 
+const QUIT_POINT: String = "quit"
+
 var session: Quest1Session = null
 var view: CollectCallView = null
 var card: Quest1Card = Quest1Card.new()
@@ -139,6 +141,22 @@ func _process(_delta: float) -> void:
 		card.show_failed(_can_continue())
 
 
+## Quit (SAV-08): a game in progress writes its state as the "quit" autosave and waits for the write
+## before the window closes. A finished or failed run has its own saves (quest end, last beat).
+func save_on_quit() -> bool:
+	if session == null or _ended or session.failed():
+		return false
+	var wrote: bool = session.autosave.save_now(QUIT_POINT)
+	Save.flush()
+	return wrote
+
+
+func _notification(what: int) -> void:
+	if what == NOTIFICATION_WM_CLOSE_REQUEST:
+		@warning_ignore("return_value_discarded")
+		save_on_quit()
+
+
 func set_paused(on: bool) -> void:
 	paused = on
 	session.world.set_process(not on)
diff --git a/project/tests/scenarios/scenario_autosave_input.gd b/project/tests/scenarios/scenario_autosave_input.gd
index 854cc73..52f9a36 100644
--- a/project/tests/scenarios/scenario_autosave_input.gd
+++ b/project/tests/scenarios/scenario_autosave_input.gd
@@ -100,4 +100,29 @@ func _continue_button(game: Quest1Game, log: Dictionary) -> String:
 	if s == null or s.beat_id() != "b3-toner-room":
 		return "Continue did not resume the surviving slot's beat"
 	log["continue_button"] = {"beat": s.beat_id(), "sink_on": s.autosave.sink.is_valid()}
-	return "" if s.autosave.sink.is_valid() else "Continue left autosave off"
+	if not s.autosave.sink.is_valid():
+		return "Continue left autosave off"
+	return _quit_save(game, log)
+
+
+## Closing the window mid-beat writes the "quit" autosave; the next load lands on that very tick.
+func _quit_save(game: Quest1Game, log: Dictionary) -> String:
+	var s: Quest1Session = game.session
+	s.world.set_process(false)
+	for i: int in 45:
+		s.step()
+	var want_tick: int = s.tick()
+	var want_hash: String = s.world.loop().state_hash()
+	if not game.save_on_quit():
+		return "save_on_quit wrote nothing mid-beat"
+	s.world.free()
+	game.session = null
+	var out: SaveLoader.Outcome = Save.load_latest(Quest1Autosave.accept(Events, Data))
+	var back: Quest1Session = out.value if out.status == SaveLoader.Status.LOADED else null
+	if back == null or out.point != "quit":
+		return "after quit the load landed on '%s'" % out.point
+	if back.tick() != want_tick or back.world.loop().state_hash() != want_hash:
+		return "the quit save did not land on its tick and hash"
+	log["quit_save"] = {"beat": back.beat_id(), "tick": back.tick(), "hash": want_hash}
+	back.world.free()
+	return ""
