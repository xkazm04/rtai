From 26d50a353eae5c21ef12098f2486be8c58fb50bb Mon Sep 17 00:00:00 2001
From: xkazm04 <kazdan@seznam.cz>
Date: Tue, 3 Nov 2026 12:24:54 +0100
Subject: [PATCH 3/3] test(save): bound-input scenario records the load's
 re-simulation time (CONTENDED)

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 evidence/autosave/autosave-input.json              | 1 +
 project/tests/scenarios/scenario_autosave_input.gd | 2 ++
 2 files changed, 3 insertions(+)

diff --git a/evidence/autosave/autosave-input.json b/evidence/autosave/autosave-input.json
index 458e694..b89ee59 100644
--- a/evidence/autosave/autosave-input.json
+++ b/evidence/autosave/autosave-input.json
@@ -8,6 +8,7 @@
     "point": "as-b4-dock",
     "tick": 5669
   },
+  "load_1_ms_contended": 751,
   "load_2": {
     "beat": "b3-toner-room",
     "tick": 2421
diff --git a/project/tests/scenarios/scenario_autosave_input.gd b/project/tests/scenarios/scenario_autosave_input.gd
index ceaf82f..854cc73 100644
--- a/project/tests/scenarios/scenario_autosave_input.gd
+++ b/project/tests/scenarios/scenario_autosave_input.gd
@@ -68,7 +68,9 @@ func _resume(game: Quest1Game, saved: Dictionary[String, Dictionary], log: Dicti
 	var census: Array[String] = SaveKit.census(slots.root)
 	if census != ["auto_a/state.sav", "auto_b/state.sav", "meta.json"]:
 		return "files on disk: %s" % [census]
+	var started_ms: int = Time.get_ticks_msec()
 	var out: SaveLoader.Outcome = Save.load_latest(Quest1Autosave.accept(Events, Data))
+	log["load_1_ms_contended"] = Time.get_ticks_msec() - started_ms
 	var s: Quest1Session = out.value if out.status == SaveLoader.Status.LOADED else null
 	if s == null or out.point != STOP_POINT:
 		return "load 1 landed on '%s'" % out.point
-- 
