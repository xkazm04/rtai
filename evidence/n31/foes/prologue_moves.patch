diff --git a/project/tests/unit/test_prologue_panic_gait.gd b/project/tests/unit/test_prologue_panic_gait.gd
new file mode 100644
index 000000000..1e78f4d76
--- /dev/null
+++ b/project/tests/unit/test_prologue_panic_gait.gd
@@ -0,0 +1,53 @@
+extends GutTest
+## n31: the yard patrol's two moves. Inside danger_m it runs at retreat_mps without a round;
+## between danger_m and retreat_gap_m it backs off at fight_speed_k of that pace and fires.
+
+const ENTRY: PackedScene = preload("res://boot/prologue/prologue.tscn")
+
+
+func _officer(game: PrologueGame) -> Fighter:
+	game.world.set_process(false)
+	var patrol: ProloguePatrol = game.encounter.patrol
+	patrol.place(game.stage.arena, true)
+	var h: Fighter = patrol.officers[1].body
+	h.pos = Vector2(18.0, 12.0)
+	return h
+
+
+func _rounds(game: PrologueGame, h: Fighter, gap: float, ticks: int) -> Array[float]:
+	var arena: CombatArena = game.stage.arena
+	var panic: ProloguePanic = game.encounter.patrol.squad.panic
+	var rng: RandomNumberGenerator = game.world.context().rng.stream(&"combat")
+	var fired: int = 0
+	var step_m: float = 0.0
+	for tick: int in ticks:
+		arena.tick = tick
+		arena.rivet.pos = h.pos + Vector2.RIGHT * gap
+		var from: Vector2 = h.pos
+		panic.regroup()
+		if panic.step(h, arena, rng, true) != null:
+			fired += 1
+		step_m = from.distance_to(h.pos)
+	return [float(fired), step_m]
+
+
+func test_inside_danger_m_the_officer_runs_without_a_round() -> void:
+	var game: PrologueGame = ENTRY.instantiate() as PrologueGame
+	add_child_autofree(game)
+	var h: Fighter = _officer(game)
+	var got: Array[float] = _rounds(game, h, 3.0, 90)
+	assert_eq(got[0], 0.0, "no round inside danger_m")
+	assert_eq(game.encounter.patrol.squad.mind_for(h).agent.gait.mode, FoeGait.Mode.TRAVEL)
+	assert_almost_eq(got[1], 6.65 * SimClock.TICK_DT, 0.01, "full retreat pace")
+	PlayerActions.shipped().install()
+
+
+func test_between_danger_m_and_the_gap_the_officer_backs_off_slowly_and_fires() -> void:
+	var game: PrologueGame = ENTRY.instantiate() as PrologueGame
+	add_child_autofree(game)
+	var h: Fighter = _officer(game)
+	var got: Array[float] = _rounds(game, h, 6.0, 150)
+	assert_gt(got[0], 0.0, "rounds while backing off")
+	assert_eq(game.encounter.patrol.squad.mind_for(h).agent.gait.mode, FoeGait.Mode.FIGHT)
+	assert_almost_eq(got[1], 0.45 * 6.65 * SimClock.TICK_DT, 0.01, "fight walk pace")
+	PlayerActions.shipped().install()
