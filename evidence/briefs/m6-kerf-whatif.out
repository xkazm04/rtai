```powershell
foreach ($k in '0.1', '0.2') {
    $out = "$($PWD.Path)/build/dev/kerf-k$k.json"
    node tools/dev/run.mjs move_ttk --move=kerf_blink_behind --seeds=10 "--slice-k=$k" "--out=$out" "--result=$out"
    if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }
}
