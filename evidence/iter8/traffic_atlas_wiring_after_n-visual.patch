--- /dev/null
+++ b/project/features/city/view/traffic_atlas.gdshader
@@ -0,0 +1,15 @@
+shader_type canvas_item;
+// Moving traffic (CrowdLayers cars + car shadows): one quad per car; the instance's custom.x is
+// its art id (city_spawner CAR_ART / ART_POLICE_CAR), which is its cell in the cols x rows
+// traffic atlas (features/city/art/vehicles/README.md). COLOR is the instance tint (white for
+// the car, translucent ink for its shadow).
+
+uniform int cols = 3;
+uniform int rows = 3;
+
+void vertex() {
+	float cell = floor(INSTANCE_CUSTOM.x + 0.5);
+	float c = mod(cell, float(cols));
+	float r = floor(cell / float(cols));
+	UV = (UV + vec2(c, r)) / vec2(float(cols), float(rows));
+}
