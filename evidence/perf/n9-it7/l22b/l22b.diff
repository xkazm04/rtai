extends GutTest
## CitySolidMemo (perf L22b): the memoised wall answer equals the direct one over stamped chunks,
## repeated points, the map's edges and off the map; a clear forgets a chunk dropped since.


func _sim(native: bool) -> CitySimBackend:
	var gen: CityGen = CityGen.from_tables(
		"res://data/tables/city_district.json", "res://data/tables/city_textures.json"
	)
	var sim: CitySimBackend = CitySimNative.new() if native else CitySimRef.new()
	sim.init(7)
	var res: CityResidency = CityResidency.new(ChunkSource.new(gen), sim, SimConst.CITY_CHUNKS)
	for cy: int in range(2, 4):
		for cx: int in range(2, 4):
			res.adopt(Vector2i(cx, cy), gen.gen_chunk(cx, cy))
	return sim


func _sweep(sim: CitySimBackend) -> void:
	var memo: CitySolidMemo = CitySolidMemo.new(sim)
	var span: float = SimConst.CHUNK_M * 5.0 * SimConst.PX_PER_M
	var solid: int = 0
	for k: int in 6000:  # px; every point asked twice (the second answer comes from the memo)
		var p: Vector2 = Vector2(fmod(k * 211.3, span) - 300.0, fmod(k * 97.7, span) - 300.0)
		var want: bool = CitySolidMemo.ask(sim, p)
		assert_eq(memo.solid(p), want, "first ask at %s" % p)
		assert_eq(
			memo.solid(p + Vector2(0.25, -0.25)), CitySolidMemo.ask(sim, p + Vector2(0.25, -0.25))
		)
		solid += 1 if want else 0
	assert_gt(solid, 200, "the sweep crosses solid cells (the compare is not all false)")
	assert_lt(memo.size(), 6000, "the nudged second ask mostly shares the first one's cell")
	for p: Vector2 in [Vector2(-0.5, 40.0), Vector2(40.0, -0.5), Vector2(SimConst.W * 32.0, 9.0)]:
		assert_false(memo.solid(p), "off the map at %s" % p)


func test_ref_memo_matches_direct() -> void:
	_sweep(_sim(false))


func test_native_memo_matches_direct() -> void:
	if not CitySimNative.available():
		pending("the native library is not loaded")
		return
	_sweep(_sim(true))


func test_clear_forgets_a_dropped_chunk() -> void:
	var sim: CitySimBackend = _sim(false)
	var memo: CitySolidMemo = CitySolidMemo.new(sim)
	var hit: Vector2 = Vector2.ZERO
	var base: float = 2.0 * SimConst.CHUNK_M * SimConst.PX_PER_M
	for k: int in 4000:
		var p: Vector2 = Vector2(base + fmod(k * 41.3, 2000.0), base + fmod(k * 17.9, 2000.0))
		if memo.solid(p):
			hit = p
			break
	assert_ne(hit, Vector2.ZERO, "found a solid cell in chunk (2, 2)")
	sim.clear_chunk(2, 2)
	assert_true(memo.solid(hit), "the memo holds its answer until cleared (the owner's contract)")
	memo.clear()
	assert_eq(memo.size(), 0)
	assert_false(memo.solid(hit), "after a clear it asks the sim again")
	assert_true(memo.serves(sim))
	assert_false(memo.serves(CitySimRef.new()))
