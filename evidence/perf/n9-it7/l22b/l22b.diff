class_name CitySolidMemo
extends RefCounted
## "Is the world px `p` inside a building or a prop?" for the blood's wall checks, memoised per
## 1 m sim cell (perf L22b). A drop moves a few px a tick and a cell is 32 px, so most of the
## riot's ~160 checks a tick hit a cell already asked this frame and skip the native call.
## Exact while the map holds still: the owner clears it around every batch of questions (the
## sim stamps and clears chunks on the main thread, never inside one).

var _sim: CitySimBackend
var _memo: Dictionary[int, bool] = {}


func _init(sim: CitySimBackend) -> void:
	_sim = sim


func solid(p: Vector2) -> bool:
	var x: float = p.x / SimConst.PX_PER_M
	var y: float = p.y / SimConst.PX_PER_M
	var ix: int = floori(x)
	var iy: int = floori(y)
	if ix < 0 or iy < 0 or ix >= SimConst.W or iy >= SimConst.W:
		return false  # off the map: cell 0, neither a building nor a prop
	var key: int = iy * SimConst.W + ix
	var known: Variant = _memo.get(key)
	if known != null:
		return known
	var s: bool = _is_solid(_sim.cell_at(x, y))
	_memo[key] = s
	return s


## The unmemoised answer (outside a batch).
static func ask(sim: CitySimBackend, p: Vector2) -> bool:
	return _is_solid(sim.cell_at(p.x / SimConst.PX_PER_M, p.y / SimConst.PX_PER_M))


static func _is_solid(c: int) -> bool:
	return c == SimConst.C_BUILD or c == SimConst.C_PROP


## True when this memo answers for `sim`.
func serves(sim: CitySimBackend) -> bool:
	return sim == _sim


## Forget every answer (call before and after a batch: the map may change between frames).
func clear() -> void:
	_memo.clear()


## Cells answered since the last clear (tests).
func size() -> int:
	return _memo.size()
