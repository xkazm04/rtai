--- project/dev/prof_run.gd
extends RefCounted


func run(tree: SceneTree) -> int:
	for arm: int in 6:
		var view: String = "combo"
		StreetWalkerCards.OPT_XFORM = arm % 2 == 1
		StreetWalkerCards.OPT_ROW = arm % 2 == 1
		printerr("ARM opt=%s" % (arm % 2 == 1))
		ViewMode._shared = ViewMode.of(view)
		for i: int in 20:
			CutRig.PROF[i] = 0
		var bus: EventBus = EventBus.new()
		var data: DataStore = DataStore.new()
		var ctx: WorldContext = World.build_context(bus, data, 9)
		var rigs: CharacterRigs = CharacterRigs.new()
		tree.root.add_child(rigs)
		rigs.setup(ctx)
		var stress: RigStress = RigStress.new(rigs, 50)
		stress.run(600)
		var m: Dictionary[String, float] = stress.metrics()
		var p: PackedInt64Array = CutRig.PROF
		printerr(
			"PROF %s p50 %.3f ms | drives %d | us/tick: gait+ %.1f pose %.1f lift %.1f headcard %.1f street %.1f post %.1f assign %.1f"
			% [view, m["rigMsP50"], p[6], p[0] / 600.0, p[1] / 600.0, p[2] / 600.0, p[3] / 600.0, p[4] / 600.0, p[5] / 600.0, p[7] / 600.0]
		)
		printerr(
			"PROF2 %s us/tick: shield %.1f crowd %.1f walker %.1f rivet %.1f | walker: strip %.1f build %.1f hide %.1f place %.1f (n %d) | head: place %.1f"
			% [view, p[8] / 600.0, p[9] / 600.0, p[10] / 600.0, p[11] / 600.0, p[12] / 600.0, p[13] / 600.0, p[14] / 600.0, p[15] / 600.0, p[16], p[17] / 600.0]
		)
		rigs.free()
		bus.free()
		data.free()
	return 0
--- project/dev/prof_scratch.gd
extends SceneTree


func _initialize() -> void:
	var script: GDScript = load("res://dev/prof_run.gd")
	var runner: Object = script.new()
	runner.call("run", self)
	quit(0)
