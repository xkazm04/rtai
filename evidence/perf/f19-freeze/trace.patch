 static func blade_of(flag: String) -> StringName:
 	return &"" if flag == "" or flag == "off" else StringName(flag)
+
+
+func _hbp(what: String) -> void:
+	if Engine.get_meta(&"hb", 0) < 90:
+		printerr(what)
