--- a/project/features/combat/kills/kill_mark_art.gd
+++ b/project/features/combat/kills/kill_mark_art.gd
@@ -18,6 +18,16 @@ const RUN: float = 0.55
 const FINGERS: int = 3
 
 
+static func flashes(
+	ci: CanvasItem, kills: SignatureKills, ppm: float, quiet: Dictionary[KillMarks.Mark, bool]
+) -> void:
+	for m: KillMarks.Mark in kills.marks.marks:
+		var age: int = kills.tick - m.tick
+		var soot: int = 2 if m.flash_scale >= 1.0 else 0
+		if not quiet.has(m) and age >= 0 and age < m.flash_ticks + soot:
+			flash(ci, m, age, ppm, m.flash_ticks)
+
+
 static func scorch(ci: CanvasItem, m: KillMarks.Mark, ppm: float) -> void:
 	if m.line_m > 0.0:
 		scorch_line(ci, m, ppm)
