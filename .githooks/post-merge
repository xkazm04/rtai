#!/bin/sh
command -v git-lfs >/dev/null 2>&1 || { echo >&2 "\nThis repository is configured for Git LFS but 'git-lfs' was not found on your path. If you no longer wish to use Git LFS, remove this hook by deleting the 'post-merge' file in the hooks directory (set by 'core.hookspath'; usually '.git/hooks').\n"; exit 2; }
git lfs post-merge "$@"; lfs_status=$?
# /perfect godot-runner: notice only (never blocks, starts no Godot); runners auto-import a stale class cache.
node -e "import('./tools/lib/class_cache.mjs').then(m=>{const r=m.isStale('project');if(r.stale)console.error('class cache stale ('+r.reason+'): the next runner auto-imports; check one script with node tools/godot/check.mjs <res://path>')})" 2>/dev/null || true
exit $lfs_status
