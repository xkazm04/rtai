            "additionalProperties": false,
            "properties": {
              "do": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "by": {
                      "minimum": 1,
                      "type": "integer"
                    },
                    "flag": {
                      "pattern": "^[a-z][a-z0-9_]*$",
                      "type": "string"
                    },
                    "op": {
                      "enum": [
                        "stat_inc",
                        "flag",
                        "unlock"
                      ]
                    },
                    "stat": {
                      "$ref": "#/$defs/statId"
                    }
                  },
                  "required": [
                    "op"
                  ],
                  "type": "object"
                },
                "minItems": 1,
                "type": "array"
              },
              "on": {
                "pattern": "^[a-z][a-z0-9_]*$",
                "type": "string"
              },
              "unlock_when": {
                "additionalProperties": false,
                "properties": {
                  "flag_all": {
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": "array"
                  },
                  "stat_gte": {
                    "additionalProperties": false,
                    "properties": {
                      "stat": {
                        "$ref": "#/$defs/statId"
                      },
                      "value": {
                        "minimum": 1,
                        "type": "integer"
                      }
                    },
                    "required": [
                      "stat",
                      "value"
                    ],
                    "type": "object"
                  }
                },
                "type": "object"
              },
              "where": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "eq": {
                      "type": [
                        "integer",
                        "string",
                        "boolean"
                      ]
                    },
                    "gte": {
                      "type": "integer"
                    },
                    "in": {
                      "minItems": 1,
                      "type": "array"
                    },
                    "param": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "param"
                  ],
                  "type": "object"
                },
                "type": "array"
              }
            },
            "required": [
              "on",
              "do"
            ],
            "type": "object"
          }
