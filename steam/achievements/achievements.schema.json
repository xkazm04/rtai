          "max": {
            "type": "integer"
          },
          "min": {
            "type": "integer"
          },
          "type": {
            "enum": [
              "int"
            ]
          }
        },
        "required": [
          "id",
          "type",
          "min",
          "max",
          "default"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "schema",
    "languages",
    "stats",
    "achievements"
  ],
  "type": "object"
}
