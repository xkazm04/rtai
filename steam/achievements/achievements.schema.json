        "required": [
          "id",
          "block",
          "name",
          "desc",
          "hidden",
          "stat",
          "trigger",
          "missable",
          "icon",
          "source"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "languages": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "schema": {
      "const": "gtai.achievements/1"
    },
    "stats": {
      "items": {
        "additionalProperties": false,
